# Public Supabase project values (safe for browser use; use the project's publishable/anon key).
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-or-anon-key

# Canonical application origin used to construct allow-listed Auth recovery redirects.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Server-only. Required exclusively by trusted admin account-invitation endpoints.
# Never prefix this variable with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Server-only. Multimodal AI configuration for AI Waste Visual Analyzer (Phase B8).
# Supported providers: openai, gemini, anthropic.
# Never prefix these variables with NEXT_PUBLIC_.
AI_PROVIDER=openai
AI_MODEL=gpt-4o-mini
OPENAI_API_KEY=your-openai-api-key
GEMINI_API_KEY=your-gemini-api-key
ANTHROPIC_API_KEY=your-anthropic-api-key
